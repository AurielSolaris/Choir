<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- API 29-32 read audio through the storage permission; 33+ scopes it to audio only. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Held for exactly one feature: fetching lyrics from a service the user has
      switched on in Settings. It is off by default, and while it is off nothing
      in Choir opens a socket.

      Because this permission exists, Choir can no longer claim it is unable to
      reach the network — only that it does not, unless asked. When it is asked,
      what goes out is a track's title, artist and duration, to the provider the
      user chose. No account, no identifier, no library contents, no telemetry.

      ACCESS_NETWORK_STATE is what lets the fetch respect "unmetered only", so
      lyrics are never quietly bought with someone's mobile data.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".ChoirApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Choir"
        android:usesCleartextTraffic="false">

        <!--
          adjustResize is what makes the window report an IME inset, which is
          what Compose's imePadding() on the search screen reads. Without it the
          system pans instead and results hide under the keyboard.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Choir"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The audio picker other apps see. Kept out of the launcher: it is only
          ever reached through someone else's GET_CONTENT or PICK request.
        -->
        <activity
            android:name=".ui.picker.MusicPickerActivity"
            android:exported="true"
            android:label="@string/picker_label"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Choir"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.GET_CONTENT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PICK" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="vnd.android.cursor.dir/audio" />
            </intent-filter>
        </activity>

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!--
          The home screen widgets.

          Each is a GlanceAppWidgetReceiver, which is an ordinary broadcast
          receiver the launcher talks to. Exported because the launcher is a
          different application and has to be able to reach them; they accept
          nothing but the platform's own APPWIDGET_UPDATE, and every control on
          them runs through Glance's own callback mechanism inside this app.

          None of them declares an update period. Every redraw is provoked by
          something the player did — see WidgetPublisher — so a polling period
          would only wake the device to redraw what had not changed.
        -->
        <receiver
            android:name=".ui.widget.NowPlayingWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_now_playing">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_now_playing_info" />
        </receiver>

        <receiver
            android:name=".ui.widget.CompactControlsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_compact_controls">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_compact_controls_info" />
        </receiver>

        <receiver
            android:name=".ui.widget.LikedSongsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_liked_songs">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_liked_songs_info" />
        </receiver>

        <receiver
            android:name=".ui.widget.LyricLineWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_lyric_line">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_lyric_line_info" />
        </receiver>

    </application>

</manifest>
