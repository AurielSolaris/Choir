<!--
  SPDX-FileCopyrightText: 2026 AurielSolaris
  SPDX-License-Identifier: GPL-3.0-or-later

  What the widget picker shows before the widget is placed.

  A static layout, not the widget: the picker draws this without starting a
  Glance session, so it holds no snapshot and reads nothing. Its job is to make
  the four distinguishable from each other at a glance, in Choir's own type and
  paper rather than as four copies of the app icon.

  Plain RemoteViews widgets only — LinearLayout, TextView, ImageView. Anything
  the launcher's process cannot inflate silently shows as nothing at all.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:maxLines="1"
        android:text="@string/widget_compact_controls"
        android:textColor="@color/widget_on_background"
        android:textSize="13sp" />

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_widget_previous"
        android:tint="@color/widget_on_background" />

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="12dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_widget_play"
        android:tint="@color/widget_on_background" />

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="12dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_widget_next"
        android:tint="@color/widget_on_background" />
</LinearLayout>
